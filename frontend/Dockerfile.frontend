FROM node:20-alpine AS base

WORKDIR /app

COPY ./package.json ./yarn.lock ./
# Yarn Classic (packageManager: yarn@1.22.22). --frozen-lockfile keeps
# Portainer/prod builds deterministic and fails loudly if lock is stale.
RUN yarn install --frozen-lockfile

COPY ./ .

ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000

# Build de produção real (`next build && next start`). Usado por
# docker-compose.prod.yml via `build.target: prod`. NEXT_PUBLIC_API_URL
# precisa estar disponível em build time — `next build` inlina NEXT_PUBLIC_*
# no bundle do browser, diferente do `next dev` (que relê a cada compilação).
FROM base AS prod
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN yarn build
CMD ["yarn", "start", "-p", "3000"]

# Stage padrão (nenhum `target:` explícito no build) — precisa ser o ÚLTIMO
# stage do arquivo, pois `docker build` sem `target:` builda o último por
# padrão. Usado por docker-compose.yml e docker-compose.all.yml (dev
# local). NEXT_PUBLIC_* é lido em runtime a cada compilação do `next dev`,
# então a env var do container basta, sem precisar de build ARG.
FROM base AS dev
CMD ["yarn", "dev", "-p", "3000"]
