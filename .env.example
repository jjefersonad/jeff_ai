# ./.env (raiz) — única fonte de configuração operacional do Jeff AI.
# Copie para `./.env` e preencha. Compose (`docker-compose.yml` /
# `docker-compose.prod.yml` / `docker-compose.all.yml`), `load_env()` bare-metal
# e o frontend leem só daqui.
#
# Variáveis injetadas pelo Compose (não editáveis pelo operador, documentadas
# como derivadas): LANGGRAPH_STORE, LANGGRAPH_CHECKPOINTER, LANGGRAPH_HTTP,
# LANGGRAPH_AUTH, CORS_ALLOW_ORIGINS.

# =============================================================================
# URLs / origens
# =============================================================================

# Origem pública do BACKEND (docs, mídia, callers servidor-a-servidor como
# Evolution). Sem ela, cai em FRONTEND_ORIGIN e depois em http://localhost:3000.
# Em produção ou com tunel (ngrok / Cloudflare), use a URL alcançável de fora.
BASE_URL=

# Origem exata do frontend (protocolo+host+porta). NUNCA "*" com
# allow_credentials=true. Usada para CORS (LANGGRAPH_HTTP / CORS_ALLOW_ORIGINS).
FRONTEND_ORIGIN=http://localhost:3002

# Origem pública do backend (NEXT_PUBLIC_* — build/dev-server Next E processo
# Python do backend/telegram_gateway). Usada pelo frontend para chamar a API e
# por `public_api_origin()` para montar URLs absolutas de imagens geradas
# (`/api/images/...`). Em Docker Compose o default é a porta publicada no host;
# fora do Docker, ajuste para a porta real do backend (ex.: http://localhost:8000).
NEXT_PUBLIC_API_URL=http://localhost:8001

# Alvo server-side dos rewrites() do Next (frontend/next.config.ts). Em
# Docker Compose o default já aponta pro hostname interno (backend:8000).
BACKEND_INTERNAL_URL=http://backend:8000

# Endpoint do servidor Ollama. Em `docker-compose.all.yml` o default interno
# é http://jeff_ia_ollama:11434; em dev diário costuma ser o host.
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# Dados Jeff AI
# =============================================================================

# Postgres/Redis GERENCIADOS — obrigatórios em docker-compose.prod.yml
# (sem containers locais). Em dev, POSTGRES_URI pode ser omitido: o compose
# deriva de POSTGRES_USER/PASSWORD/DB abaixo.
POSTGRES_URI=postgresql://user:password@host:5432/jeff_ia
REDIS_URI=redis://:password@host:6379/0

# Credenciais do Postgres local (container jeff_ia_postgres). Defaults de
# histórico (jeff_ia/jeff_ia/jeff_ia). Trocar aqui atualiza o POSTGRES_URI
# derivado no compose de dev.
POSTGRES_DB=jeff_ia
POSTGRES_USER=jeff_ia
POSTGRES_PASSWORD=jeff_ia

# Senha do Redis local (jeff_ia_redis), via --requirepass. Não usada em
# docker-compose.prod.yml (lá o Redis é gerenciado via REDIS_URI).
REDIS_PASSWORD=

# =============================================================================
# Modelos / LLM
# =============================================================================

OLLAMA_MODEL=minimax-m2.7:cloud

# Janela de contexto. 8192 estoura com system prompt + schemas de tools
# (~13.900 tokens); 32768 dá margem. Custa VRAM.
OLLAMA_NUM_CTX=32768

# Embeddings do índice vetorial do Store (memória de longo prazo).
OLLAMA_EMBED_MODEL=mxbai-embed-large

GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.5-flash

# OpenRouter — fallback quando Ollama Cloud falha/sem créditos
# (ver src/models/fallback_model.py).
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=Jeff AI

TAVILY_API_KEY=your_tavily_api_key_here

# Tool `web_fetch` — leitura de URL HTTP(S) (não é busca; ver internet_search).
# Defaults seguros se omitidos.
WEB_FETCH_TIMEOUT=20
WEB_FETCH_MAX_BYTES=2097152
WEB_FETCH_MAX_CHARS=100000
WEB_FETCH_MAX_REDIRECTS=5

# =============================================================================
# Auth / sessão
# =============================================================================

# Bootstrap do primeiro admin (só no startup se `users` estiver vazia).
# ADMIN_PASSWORD_HASH = bcrypt (passlib), NUNCA senha em texto plano.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# TTL da sessão em segundos (default 3600).
SESSION_TTL=3600

# Cookie de sessão cross-subdomain (front jeff.X + API jeff-api.X).
# Ex.: COOKIE_DOMAIN=.conexaoelite.com.br — vazio em localhost.
COOKIE_DOMAIN=
# strict | lax | none (default lax; use lax/none se front e API forem hosts distintos)
COOKIE_SAMESITE=lax

# Prefixos isentos de require_auth (vírgula). Default inclui /public/,
# /api/webhooks/whatsapp/, etc. — só sobrescreva se souber o impacto.
PUBLIC_PATHS=

# Fernet para cifra em repouso de user_integrations.config. Gerar com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_CREDENTIALS_KEY=

# =============================================================================
# Observabilidade
# =============================================================================

# Necessário para LangGraph API free tier.
LANGSMITH_API_KEY=your_langsmith_api_key_here

# Compose injeta true / jeff_ai_project se omitidos; documentados aqui para
# bare-metal e override explícito.
LANGCHAIN_TRACING_V2=true
LANGSMITH_PROJECT=jeff_ai_project
LANGCHAIN_VERBOSE=true

# =============================================================================
# Telegram
# =============================================================================

# Sem TELEGRAM_BOT_TOKEN + TELEGRAM_AUTHORIZED_CHAT_ID o telegram_gateway
# não sobe. TELEGRAM_LEGACY_OWNER_USER_ID = users.id dono da memória quando
# o chat está só na allowlist legado (fix-memory-access-user-identity).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_AUTHORIZED_CHAT_ID=
TELEGRAM_LEGACY_OWNER_USER_ID=

# @handle público do bot (sem o @) — usado para montar o deep link
# t.me/<username>?start=<código> na tela de Integrações (channel-link-wiring).
# Opcional: sem ela, o link de vínculo por clique some e só o código
# copiável continua disponível.
TELEGRAM_BOT_USERNAME=conexaoelite_jeff_bot

# =============================================================================
# Email Sync Worker (change email-client-imap-mvp)
# =============================================================================
#
# Intervalo em segundos entre passadas do poll loop do `email_sync_worker`.
# Default conservador: 60s — bem dentro do orçamento para provedores IMAP
# típicos sem rate-limit agressivo, e mantém a latência de inbox baixa para
# usuários novos. Operador pode tunar (ex.: 30s para testes) sem rebuild.
# Sem essa var definida, o script Python usa 60s.
EMAIL_SYNC_POLL_INTERVAL_SECONDS=60

# Gmail OAuth2 (change gmail-account-oauth-connection) — credenciais do app
# OAuth no Google Cloud Console. Distintas de GOOGLE_API_KEY (usada pelo
# Gemini). Sem as três, build_authorize_url() falha rápido com um erro
# acionável em vez de deixar o fluxo "Continuar com Google" quebrar depois.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# =============================================================================
# Evolution / WhatsApp
# =============================================================================

EVOLUTION_API_URL=http://evolution_api:8080
EVOLUTION_API_KEY=your_evolution_api_key_here
EVOLUTION_INSTANCE_NAME=jeff-ai-central

# Número público do WhatsApp Business em E.164 (ex.: 5511999999999, sem "+").
# Usado para montar o deep link wa.me/<número>?text=<código> na tela de
# Integrações (channel-link-wiring). Opcional, mesma degradação graciosa que
# TELEGRAM_BOT_USERNAME. Pode precisar trocar se o número for banido/rotacionado
# pela Meta — não exige rebuild do frontend (GET /api/integrations/channel-config
# lê em runtime, não é NEXT_PUBLIC_*).
WHATSAPP_BUSINESS_NUMBER=5561947581258

# Token embutido em /api/webhooks/whatsapp/<token> — auth real da rota
# (isenta de require_auth via PUBLIC_PATHS). Gerar com:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
EVOLUTION_WEBHOOK_TOKEN=your_evolution_webhook_token_here

# Postgres/Redis dedicados da Evolution (containers evolution_*). Não
# confundir com POSTGRES_URI / REDIS_URI do Jeff AI.
EVOLUTION_POSTGRES_PASSWORD=
EVOLUTION_REDIS_PASSWORD=

# URL pública que a Evolution usa para webhooks/QR. Em produção: domínio real.
EVOLUTION_SERVER_URL=http://localhost:8085

# Indicador de "digitando..." em Telegram/WhatsApp enquanto o agente processa
# a mensagem (typing-indicator-chat-channels). Kill-switch de operador sem
# redeploy — "false" desliga start/stop em HandleChatMessage.execute para
# todos os canais. Default "true".
TYPING_INDICATOR_ENABLED=true

# =============================================================================
# Agent / tools
# =============================================================================

# IANA timezone (ex.: America/Sao_Paulo). Default no compose: UTC.
# Usado pelo prompt, get_date_time_current e APScheduler (schedule.expr = horário
# local deste fuso). O compose também espelha em TZ (libc/`date`). Runtime:
# JEFF_AI_TZ → TZ → UTC. Sem migração de tarefas once antigas criadas sob o
# bug (tool devolvia UTC): recriar se o disparo estiver errado. Smoke: "que
# horas são?" + once em poucos minutos.
JEFF_AI_TZ=UTC

# Repos liberados para install_external_skill (além dos defaults). Vírgula.
SKILLS_ALLOWLIST=

# Limiar de relevância de skills (default 0.5).
SKILL_RELEVANCE_THRESHOLD=0.5

# Timeout do run_shell_command em segundos (default 180).
SHELL_COMMAND_TIMEOUT=180

# Regexes extras da denylist do shell, separados por ';'.
SHELL_DENYLIST=

GIT_DIFF_MAX_CHARS=200000
GIT_TIMEOUT=30
TEST_TIMEOUT=300

# Intervalo (em horas) do scan periódico de follow-up do CRM
# (D-006 sales-pipeline-via-agent). `0` = desabilitado (default —
# fail-safe enquanto a change `agendamento-jeff-cli` não plugar o
# retorno de `followup_scan.periodic_scheduled_tasks()` no boot).
# Quando > 0, cron `0 */N * * *` é registrado como `sales_followup_scan`.
JEFF_AI_SALES_FOLLOWUP_SCAN_INTERVAL_HOURS=0

# =============================================================================
# Dev UI (pgAdmin) — docker-compose.yml / all, profile "admin"
# =============================================================================

# Defaults de dev inseguros; TROCAR antes de expor a porta 5050.
PGADMIN_DEFAULT_EMAIL=admin@admin.local
PGADMIN_DEFAULT_PASSWORD=admin123

# =============================================================================
# Paths opcionais
# =============================================================================

# Defaults no container: /deps/backend/outputs/{documents,images}.
DOCUMENTS_DIR=
IMAGES_DIR=

# Árvore por usuário: files/<user_id>/{attachment,images,docs} (session-file-sandbox).
# Default no código: backend/files/ (ou /deps/backend/files no container).
FILES_DIR=

# =============================================================================
# SEO / verificação
# =============================================================================

# Token emitido pelo Google Search Console para provar propriedade de
# `https://jeff.conexaoelite.com.br` (property type "URL prefix"). Quando
# preenchido, `frontend/src/app/layout.tsx` injeta
# `<meta name="google-site-verification" content="<token>">` em toda rota.
# Deixe vazio para desabilitar (degradação graciosa — nenhum meta tag é
# renderizado). Não usar prefixo `NEXT_PUBLIC_` — o valor é consumido apenas
# server-side dentro do `metadata` export; o prefixo só é necessário quando o
# valor é lido por JS de browser (e.g. `NEXT_PUBLIC_API_URL`).
# Para obter: Search Console → "Add property" → URL prefix
# `https://jeff.conexaoelite.com.br` → método "HTML tag" → copie o valor do
# atributo `content` exibido.
GOOGLE_SITE_VERIFICATION=

