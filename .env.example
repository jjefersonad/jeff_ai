# ./.env (raiz) — lido pelo Docker Compose para resolver `${...}` em
# docker-compose.yml / docker-compose.evolution.yml / docker-compose.prod.yml /
# docker-compose.ollama.yml.
#
# Regra: TUDO que aparece como `${VAR}` em algum `docker-compose*.yml` mora
# aqui, nunca em `backend/.env`. O `env_file: backend/.env` só entrega
# variáveis DENTRO do container — o Compose nunca o lê para resolver `${...}`
# no próprio YAML. Se uma chave existir nos dois arquivos, o bloco
# `environment:` (vindo daqui) sempre vence sobre `env_file:` — foi assim que
# um valor divergente em backend/.env ficou invisível/ignorado até ser achado.
# Segredos que o processo Python só lê via env_file (nunca interpolados pelo
# Compose) ficam em backend/.env.example.

# === Compartilhadas por todos os docker-compose*.yml ===

# Necessário para LangGraph API free tier.
LANGSMITH_API_KEY=your_langsmith_api_key_here

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=minimax-m2.7:cloud

# IANA timezone (ex.: America/Sao_Paulo). Default no compose: UTC.
JEFF_AI_TZ=UTC

# Origem exata do frontend (protocolo+host+porta). NUNCA "*" com
# allow_credentials=true (bloqueado pelos navegadores). Usada para CORS
# (LANGGRAPH_HTTP/CORS_ALLOW_ORIGINS) do backend.
FRONTEND_ORIGIN=http://localhost:3002

# Repos de terceiros liberados para install_external_skill, além dos
# defaults oficiais. Lista separada por vírgula. Opcional.
SKILLS_ALLOWLIST=

# === docker-compose.yml / docker-compose.evolution.yml / docker-compose.ollama.yml (dev local) ===

# Senha do Redis local (jeff_ia_redis), via --requirepass. Não usada em
# docker-compose.prod.yml (lá o Redis é gerenciado, ver REDIS_URI abaixo).
REDIS_PASSWORD=

# Credenciais do Postgres local (container jeff_ia_postgres). Opcionais —
# default idêntico ao valor hardcoded historicamente (jeff_ia/jeff_ia/jeff_ia).
# Trocar aqui também atualiza automaticamente o POSTGRES_URI usado pelo
# backend/telegram_gateway (mesma variável, sem duplicação).
POSTGRES_DB=jeff_ia
POSTGRES_USER=jeff_ia
POSTGRES_PASSWORD=jeff_ia

# Credenciais de login do pgAdmin (container jeff_ia_pgadmin, porta 5050,
# perfil "admin"). Opcionais — default de dev claramente inseguro; TROCAR
# antes de expor essa porta fora do localhost.
PGADMIN_DEFAULT_EMAIL=admin@admin.local
PGADMIN_DEFAULT_PASSWORD=admin123

# === docker-compose.prod.yml (produção) ===

# Postgres/Redis GERENCIADOS (RDS, VM própria, Redis Cloud, etc.) — NÃO
# sobem como container em produção. Obrigatórias: sem elas o compose falha
# com "variable is not set".
POSTGRES_URI=postgresql://user:password@host:5432/jeff_ia
REDIS_URI=redis://:password@host:6379/0

# Origem pública do backend, alcançável pelo navegador do usuário final —
# NUNCA um hostname interno do docker-compose (ex.: http://backend:8000).
NEXT_PUBLIC_API_URL=https://api.seu-dominio.com

# Alvo server-side dos rewrites() do Next (frontend/next.config.ts). Em
# Docker Compose, o default já aponta pro hostname interno correto
# (backend:8000) — só sobrescrever se o backend rodar fora deste compose.
BACKEND_INTERNAL_URL=http://backend:8000

# === Evolution API / WhatsApp (whatsapp-evolution-channel) ===

# Usadas pelo backend para chamar a Evolution API (cliente HTTP).
EVOLUTION_API_URL=http://evolution_api:8080
EVOLUTION_API_KEY=your_evolution_api_key_here
EVOLUTION_INSTANCE_NAME=jeff-ai-central

# Token compartilhado embutido na URL do webhook
# (/api/webhooks/whatsapp/<token>) — mecanismo de autenticação real da rota
# (isenta de require_auth via PUBLIC_PATHS). Configure a URL completa, com
# este token, como webhook da instância na Evolution API. Gerar com:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
EVOLUTION_WEBHOOK_TOKEN=your_evolution_webhook_token_here

# Senhas do Postgres/Redis dedicados da Evolution API (containers
# evolution_postgres/evolution_redis — bundle autocontido, sempre local
# mesmo em produção; não confundir com POSTGRES_URI/REDIS_URI acima).
EVOLUTION_POSTGRES_PASSWORD=
EVOLUTION_REDIS_PASSWORD=

# URL pública que a própria Evolution API usa para montar webhooks/QR. Em
# produção DEVE ser o domínio real; default é http://localhost:8085 (dev).
EVOLUTION_SERVER_URL=http://localhost:8085
