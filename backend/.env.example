# backend/.env — segredos e config que o processo Python lê diretamente
# (via `env_file:` no Docker Compose, ou via `src/composition/env.py:load_env()`
# em execução bare-metal). NENHUMA chave aqui é referenciada como `${...}` em
# nenhum `docker-compose*.yml` — se precisar adicionar uma que seja, ela
# pertence a `../.env.example` (raiz), não aqui, senão o Compose a ignora
# silenciosamente (o bloco `environment:` sempre vence sobre `env_file:`).
#
# Variáveis de infra compartilhadas — POSTGRES_URI, REDIS_URI, OLLAMA_BASE_URL,
# OLLAMA_MODEL, LANGSMITH_API_KEY, LANGCHAIN_TRACING_V2, LANGSMITH_PROJECT,
# FRONTEND_ORIGIN, JEFF_AI_TZ, SKILLS_ALLOWLIST, REDIS_PASSWORD, EVOLUTION_* —
# vivem em `../.env.example`.

# Ollama Configuration — só o que NÃO é interpolado por nenhum docker-compose*.yml.
OLLAMA_NUM_CTX=32768
# Janela de contexto do modelo. 8192 estoura com o system prompt + schemas de
# tools atuais (~13.900 tokens estimados); 32768 dá margem. Custa VRAM.

# Modelo de embeddings usado pelo índice vetorial do Store (memória de longo
# prazo). Default: mxbai-embed-large (1024 dimensões).
OLLAMA_EMBED_MODEL=mxbai-embed-large

# Bootstrap do primeiro usuário admin (autenticação por sessão). Usados uma
# única vez, no startup, quando a tabela `users` está vazia. ADMIN_PASSWORD_HASH
# é um hash bcrypt (gerado com passlib), NUNCA a senha em texto plano.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Origem pública usada para montar a `url` absoluta retornada pelas tools de
# geração de documento (create_docx_document e afins), servidas hoje pelo
# http.app do backend (src/infrastructure/web/webapp.py), NÃO por
# image_server.py:8080 (aposentado em consolidate-http-routes-langgraph).
# Opcional: se ausente, cai para FRONTEND_ORIGIN e, por fim, para
# http://localhost:3000. Só sete explicitamente se documentos precisarem ser
# servidos de uma origem diferente do frontend (ex.: CDN em produção).
DOCUMENT_BASE_URL=

# Tavily API (web search)
TAVILY_API_KEY=your_tavily_api_key_here

# Google API Keys
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.5-flash

# OpenRouter (fallback automático quando o Ollama Cloud falha/sem créditos —
# ver src/models/fallback_model.py)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=Jeff AI

# LangSmith — só LANGCHAIN_VERBOSE fica aqui (LANGCHAIN_TRACING_V2,
# LANGSMITH_PROJECT e LANGSMITH_API_KEY são interpoladas pelo Compose a
# partir de ../.env).
LANGCHAIN_VERBOSE=true

# Telegram (integracao-telegram) — token do bot (via @BotFather) e o único
# chat_id autorizado a conversar com o agente (allowlist single-user nesta
# versão; ver telegram-channel-spec REQ-002). Sem essas duas variáveis o
# processo telegram_gateway.py não sobe.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_AUTHORIZED_CHAT_ID=
# UUID de users.id dono da memória/ownership quando o chat está só na
# allowlist legado (TELEGRAM_AUTHORIZED_CHAT_ID) e ainda não há vínculo em
# user_integrations. Tipicamente o admin bootstrap. Vínculo real em
# integrações (user_integrations) tem precedência sobre esta env.
# (fix-memory-access-user-identity)
TELEGRAM_LEGACY_OWNER_USER_ID=

# Chave simétrica Fernet para cifra em repouso de user_integrations.config
# (user-integration-credentials) — Telegram, WhatsApp Business, SMTP. Gerar com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_CREDENTIALS_KEY=
