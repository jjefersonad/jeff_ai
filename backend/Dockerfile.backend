FROM langchain/langgraph-api:3.11

COPY backend/ /deps/backend/
WORKDIR /deps/backend

# Node/npx para instalação de skills externas (npx skills add) pelo assistant.
# WeasyPrint (HTML→PDF, change html-document-tools) precisa de cairo/pango/
# gdk-pixbuf + fontes no sistema — pip sozinho não basta.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        nodejs \
        npm \
        libcairo2 \
        libpango-1.0-0 \
        libpangocairo-1.0-0 \
        libgdk-pixbuf-2.0-0 \
        libffi-dev \
        shared-mime-info \
        fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# Install project dependencies (versões fixadas para build reproduzível).
# langgraph-runtime-inmem é reinstalado para satisfazer o langgraph-api 0.10.0 da
# imagem base (evita o warning de dependência órfã após o upgrade do langgraph).
RUN pip install --no-cache-dir \
    "python-dotenv==1.2.2" \
    "wcmatch==10.2.1" \
    "tavily==1.1.0" \
    "deepagents==0.6.12" \
    "langchain-ollama==1.1.0" \
    "langchain-openrouter==0.2.6" \
    # Faixa ampliada em 2026-07-23: a versão `<0.31.0` que estava fixada
    # tornava o `langgraph-api 0.11.1` (instalado pela imagem base
    # `langchain/langgraph-api:3.11`) incompatível com o runtime. Sintoma:
    # `Worker stats` mostra `active=0` e `requests_queued=5` parado — o
    # runtime enfileira mas nunca processa. Sem o fix, qualquer
    # `agent_runner.run()` que chega do `telegram_gateway` fica preso
    # no pool do backend e o bot não responde nada.
    "langgraph-runtime-inmem>=0.30.0,<0.32.0" \
    "python-docx==1.2.0" \
    "openpyxl==3.1.5" \
    "python-pptx==1.0.2" \
    "pypdf==6.14.2" \
    # HTML→PDF canônico (change html-document-tools). Faixa alinhada a
    # `weasyprint>=62.0,<67` do pyproject; pin reproduzível no image build.
    "weasyprint==66.0" \
    # Templates Jinja2 (`FilesystemHtmlTemplateRepository`) — importados no
    # boot do grafo `unified` via tools de documento. Sem pin explícito o
    # container falha com `No module named 'jinja2'` (pyproject tem a dep,
    # mas esta imagem instala via lista explícita).
    "jinja2==3.1.6" \
    "langchain-text-splitters==1.1.2" \
    "langchain-mcp-adapters==0.3.0" \
    # `mcp` (transitiva de langchain-mcp-adapters) precisa ser fixada
    # explicitamente aqui também — sem isso, o `pip install` do build resolve
    # o `mcp` mais novo disponível no PyPI no momento do build, não a versão
    # travada em `uv.lock` (1.28.1). Sintoma real (2026-08-03): container
    # inteiro falha no boot com `ImportError: cannot import name
    # 'RequestContext' from 'mcp.shared.context'` — `RequestContext` foi
    # movido/renomeado em versões mais novas do `mcp`, incompatível com
    # `langchain-mcp-adapters==0.3.0`. Derruba TODO o `webapp.py` (imagens,
    # documentos, auth, integrações — não só MCP), porque
    # `whatsapp_webhook_router.py` importa `LangGraphDirectAgentRunner` no
    # topo do módulo, puxando `build_unified()` e toda a cadeia de MCP no
    # carregamento do app.
    "mcp==1.28.1" \
    "markitdown[all]==0.0.1" \
    # Necessário para `POST /api/references` (`UploadFile`/`File(...)`) funcionar
    # dentro da imagem `langchain/langgraph-api:3.11`, que não inclui essa
    # dependência. Sem esta linha o upload de referência quebra em runtime no
    # container real (apenas o `.venv` local tem a dep transitiva).
    "python-multipart==0.0.20" \
    # Necessário para o `http.app` (`webapp.py`) montar `FastAPI()` e os
    # routers usarem `APIRouter`/`UploadFile`/`File`. Achado empírico do
    # test-3 (`consolidate-http-routes-langgraph-task-test-3`): a imagem
    # `langchain/langgraph-api:3.11` traz `starlette` e `uvicorn`, mas NÃO
    # `fastapi` — sem essa linha, o container não consegue carregar o
    # `http.app` registrado em `langgraph.json`.
    "fastapi==0.139.0" \
    # Necessário para `src/infrastructure/auth/security.py` (hash/verificação
    # de senha via bcrypt), importado por `auth_router.py` no carregamento de
    # `webapp.py` (change `autenticacao-jwt-rotas-protegidas`, task-rest-1).
    # `psycopg`/`psycopg-pool` (usados por `auth/db.py`) já vêm transitivos do
    # checkpointer Postgres do LangGraph; `passlib`/`bcrypt` não.
    "passlib[bcrypt]==1.7.4" \
    "bcrypt==4.0.1" \
    # Necessário para o `langgraph_api` carregar o grafo `unified` sem
    # `No module named 'telegram'`. O grafo importa `src.tools.telegram_tools`,
    # `src.infrastructure.telegram.authorization` e `src.infrastructure.telegram.commands`
    # (esta última pela change `telegram-slash-commands`), todos com imports
    # top-level de `telegram`/`telegram.error` (pacote PyPI do
    # `python-telegram-bot`). O `telegram_gateway` já faz `pip install` próprio
    # no `command:` dele, mas o **backend** também precisa — sem esta linha o
    # `collect_graphs_from_env` falha no boot. Versão alinhada com o
    # `telegram_gateway` e com o `telegram_tools.py` (que usa `Bot` e
    # `MessageLimit` do pacote). Registrado durante o verify da change
    # `telegram-slash-commands` (2026-07-23).
    "python-telegram-bot>=21.0" \
    # Necessário para `scheduling_router.py` (`GET`/`POST`/`PATCH`/`DELETE
    # /api/scheduled-tasks`) carregar — `apscheduler_task_scheduler.py` importa
    # `apscheduler.jobstores.base` no topo do módulo. Estava ausente daqui
    # (só existia no `.venv` bare-metal local), por isso o router nunca podia
    # ser montado em `webapp.py`: `app.include_router(scheduling_router)`
    # derrubava o container inteiro com `ModuleNotFoundError: No module named
    # 'apscheduler'` no boot. Versão alinhada com o `.venv` local (2026-08-04).
    "apscheduler==3.11.3" \
    # Necessário para o cliente IMAP (`src/infrastructure/email/imap_client.py`).
    "aioimaplib>=1.1.0" \
    # Necessário para o cliente SMTP (`src/infrastructure/email/smtp_client.py`).
    "aiosmtplib>=3.0.0" \
    # Necessário para sanitização de HTML de email (`src/infrastructure/email/imap_client.py`).
    "nh3>=0.2.0"

ENV PYTHONPATH="/deps/backend:$PYTHONPATH"
# `store` e `checkpointer` são lidos do `langgraph.json` (que resolve
# `${env:POSTGRES_URI}` automaticamente em runtime). As ENVs `LANGGRAPH_STORE`
# e `LANGGRAPH_CHECKPOINTER` foram removidas em 2026-07-23 porque o
# `langgraph_api` (via `starlette.config`) tentava fazer `cast=StoreConfig`
# no JSON bruto da ENV, e o placeholder `${env:POSTGRES_URI}` não-resolvido
# fazia o cast falhar com `Not a valid StoreConfig`. O `langgraph.json` é
# a fonte de verdade.
ENV LANGSERVE_GRAPHS='{"unified": "src.composition.graphs:unified", "agent": "src.composition.graphs:agent", "sdd_agent": "src.composition.graphs:sdd_agent", "assistant": "src.composition.graphs:assistant"}'
